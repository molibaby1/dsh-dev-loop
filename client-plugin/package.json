{
  "name": "dsh-dev-loop-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chinese observable run card for dsh-dev-loop",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2",
    "react": ">=18.2.0"
  }
}
